{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "claim": {
                  "type": "string"
                },
                "reviewLocation": {
                  "type": "string"
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "behavior",
                    "necessity",
                    "design",
                    "tests"
                  ]
                },
                "impact": {
                  "type": "string",
                  "enum": [
                    "material",
                    "minor"
                  ]
                },
                "diagnosis": {
                  "type": "object",
                  "properties": {
                    "rating": {
                      "type": "string",
                      "enum": [
                        "supported",
                        "unsupported",
                        "unresolved"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "maxLength": 1000
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "rating",
                    "reason",
                    "evidence"
                  ],
                  "additionalProperties": false
                },
                "recommendation": {
                  "type": "object",
                  "properties": {
                    "rating": {
                      "type": "string",
                      "enum": [
                        "supported",
                        "unsupported",
                        "unresolved"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "maxLength": 1000
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "rating",
                    "reason",
                    "evidence"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "claim",
                "reviewLocation",
                "direction",
                "impact",
                "diagnosis",
                "recommendation"
              ],
              "additionalProperties": false
            }
          },
          "targetPreservation": {
            "type": "object",
            "properties": {
              "rating": {
                "type": "string",
                "enum": [
                  "supported",
                  "unsupported",
                  "unresolved"
                ]
              },
              "reason": {
                "type": "string",
                "maxLength": 1000
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "rating",
              "reason",
              "evidence"
            ],
            "additionalProperties": false
          },
          "actionability": {
            "type": "object",
            "properties": {
              "rating": {
                "type": "string",
                "enum": [
                  "supported",
                  "unsupported",
                  "unresolved"
                ]
              },
              "reason": {
                "type": "string",
                "maxLength": 1000
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "rating",
              "reason",
              "evidence"
            ],
            "additionalProperties": false
          },
          "structuralUsefulness": {
            "type": "object",
            "properties": {
              "rating": {
                "type": "string",
                "enum": [
                  "supported",
                  "unsupported",
                  "unresolved"
                ]
              },
              "reason": {
                "type": "string",
                "maxLength": 1000
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "rating",
              "reason",
              "evidence"
            ],
            "additionalProperties": false
          },
          "materialMisses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rating": {
                  "type": "string",
                  "enum": [
                    "supported",
                    "unsupported",
                    "unresolved"
                  ]
                },
                "reason": {
                  "type": "string",
                  "maxLength": 1000
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "rating",
                "reason",
                "evidence"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "claims",
          "targetPreservation",
          "actionability",
          "structuralUsefulness",
          "materialMisses"
        ],
        "additionalProperties": false
      },
      "minItems": 6,
      "maxItems": 6
    },
    "equivalentGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "ids",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "runs",
    "equivalentGroups",
    "limitations",
    "summary"
  ],
  "additionalProperties": false
}

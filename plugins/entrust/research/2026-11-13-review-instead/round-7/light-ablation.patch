+import fs from "node:fs";
+import path from "node:path";
+import {check} from "./review.mjs";
+import {diffOf} from "./diff.mjs";
+try {
+  const file = process.argv[2];
+  if (!file) throw new Error("usage: check-analysis.mjs <analysis.json>");
+  const data = JSON.parse(fs.readFileSync(file, "utf8"));
+  if ("blocks" in data) throw new Error("This experiment omits the blocks table; preserve semantic part analysis in units/jobs.");
+  const {errors} = check(data, diffOf(data.range), path.dirname(path.resolve(file)));
+  if (errors.length) throw new Error(errors.join("\n"));
+  console.log("Experimental analysis structure/references checked; changed-line coverage NOT checked; not render-ready.");
+} catch (error) { console.error(error.message); process.exitCode = 1; }

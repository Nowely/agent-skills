{
  "$id": "order",
  "type": "object",
  "required": ["id", "status", "promisedAt"],
  "properties": {
    "id": { "type": "string" },
    "status": { "enum": ["pending", "paid", "shipped", "delivered", "cancelled"] },
    "promisedAt": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Calendar date the carrier promised, YYYY-MM-DD. Null for orders collected in store, whatever their status."
    }
  }
}

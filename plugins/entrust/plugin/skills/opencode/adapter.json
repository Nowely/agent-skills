{
  "schemaVersion": 1,
  "status": { "script": "scripts/status.mjs", "args": ["--format", "json"] },
  "launcher": "scripts/agent-run.mjs",
  "launch": "scripts/launch.mjs",
  "plan": {
    "model": "^[^\\s/|]+\\/[^\\s|]+$",
    "modelRule": "resolve and pin provider/model before registering"
  },
  "swarm": {
    "concurrency": 2,
    "briefModel": "^MODEL:\\s*[^\\s/]+\\/[^\\s]+\\s*$",
    "briefModelRule": "a pinned MODEL: provider/model"
  }
}

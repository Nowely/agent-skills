{
  "schemaVersion": 1,
  "status": { "script": "scripts/status.mjs", "args": ["--json"] },
  "launcher": "scripts/agent-run.mjs",
  "launch": "scripts/launch.mjs",
  "plan": { "models": ["opus", "sonnet", "haiku", "fable"], "native": true },
